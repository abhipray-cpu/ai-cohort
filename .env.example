# Local Codex runtime executable on the Windows service host.
CODEX_COMMAND=codex
TENDERLENS_USERNAME=reviewer
# Set a unique, long password on the service host. Do not commit its real value.
TENDERLENS_PASSWORD=replace-me

# Directories are relative to the repository root unless absolute.
APP_DATA_DIR=var
LOG_LEVEL=INFO

# Application services bind locally. Cloudflare Tunnel is the public entry point.
TENDERLENS_HOST=127.0.0.1
TENDERLENS_PORT=8000

# ResolveDesk has independent storage and processes. The local development launcher
# can reuse TenderLens credentials if these two auth variables are omitted.
RESOLVEDESK_USERNAME=reviewer
RESOLVEDESK_PASSWORD=replace-me
RESOLVEDESK_DATA_DIR=var/resolvedesk
RESOLVEDESK_HOST=127.0.0.1
RESOLVEDESK_PORT=8001
RESOLVEDESK_RUN_TIMEOUT_SECONDS=600
# Official PostgreSQL site search works without an API key. Optional Brave backend:
RESOLVEDESK_SEARCH_PROVIDER=postgresql
BRAVE_SEARCH_API_KEY=

# PropertyBrief production service uses explicit credentials. The development
# launcher may reuse TenderLens credentials if these auth settings are omitted.
PROPERTYBRIEF_USERNAME=reviewer
PROPERTYBRIEF_PASSWORD=replace-me
PROPERTYBRIEF_DATA_DIR=var/propertybrief
PROPERTYBRIEF_HOST=127.0.0.1
PROPERTYBRIEF_PORT=8002
PROPERTYBRIEF_RUN_TIMEOUT_SECONDS=900
NYC_OPEN_DATA_APP_TOKEN=

# PatchDesk bootstraps one per-user admin on first start; subsequent actors and
# project grants are independent. Development may reuse TenderLens for bootstrap.
PATCHDESK_USERNAME=reviewer
PATCHDESK_PASSWORD=replace-me
PATCHDESK_DATA_DIR=var/patchdesk
PATCHDESK_HOST=127.0.0.1
PATCHDESK_PORT=8003
PATCHDESK_RUN_TIMEOUT_SECONDS=900
# Set 1 for HTTPS deployment through the protected tunnel; 0 for loopback HTTP.
PATCHDESK_SECURE_COOKIES=0
# Disabled by default. Token availability is not publication approval.
PATCHDESK_ENABLE_PUBLISH=0
PATCHDESK_GITHUB_READ_TOKEN=
PATCHDESK_GITHUB_PUBLISH_TOKEN=

# RelayDesk bootstraps an independent admin; model/source egress remain case-scoped.
RELAYDESK_USERNAME=reviewer
RELAYDESK_PASSWORD=replace-me
RELAYDESK_DATA_DIR=var/relaydesk
RELAYDESK_ERASURE_LEDGER_DIR=var/relaydesk-erasure
RELAYDESK_HOST=127.0.0.1
RELAYDESK_PORT=8004
RELAYDESK_SECURE_COOKIES=0
RELAYDESK_EMBEDDING_DIR=var/models/relaydesk-minilm
RELAYDESK_GITHUB_READ_TOKEN=
