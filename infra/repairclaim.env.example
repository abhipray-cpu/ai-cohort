# Copy into your process environment, not another product's .env.
REPAIRCLAIM_DATA_DIR=/absolute/dedicated/repairclaim-state
REPAIRCLAIM_PUBLIC_ORIGIN=http://127.0.0.1:8011
REPAIRCLAIM_PORT=8011
REPAIRCLAIM_PARSER=auto
REPAIRCLAIM_CONTAINER_ENGINE=docker
# Enable only after operator review / explicit campaign approval.
REPAIRCLAIM_ENABLE_SOURCE_CHECKS=0
REPAIRCLAIM_ENABLE_CODEX=0
# Windows/Linux: build the isolated parser image, use REPAIRCLAIM_PARSER=container.
# Protected Cloudflare: set an HTTPS public origin and proxy only to 127.0.0.1:8011.
# Optional native Jev advisory; disabled by default. Never commit an actual key.
REPAIRCLAIM_ENABLE_JEV=0
# vercel or jevmodel; preview approval binds the exact destination and model.
REPAIRCLAIM_JEV_ROUTE=vercel
JEV_API_KEY=
# Explicit operator-owned durable journal; maximum 60 attempts / $0.60 reserved.
# jevmodel route instead enforces 16 attempts and 90,000 input tokens; no USD receipt.
REPAIRCLAIM_JEV_BUDGET_DB=
# Optional tighter limit for a NEW proxy journal; reopening cannot raise its limit.
REPAIRCLAIM_JEVMODEL_TOKEN_LIMIT=90000
